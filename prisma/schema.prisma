generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum AppealStatus {
  INITIATED
  ACCEPTED
  EXECUTED
  CLOSED
}

model User {
  uuid      String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  uuid      String   @id @default(uuid())
  name      String
  email     String
  phone     String
  router    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Appeal    Appeal[]
}

model Appeal {
  uuid       String       @id @default(uuid())
  client     Client       @relation(fields: [clientUuid], references: [uuid])
  clientUuid String
  status     AppealStatus
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
